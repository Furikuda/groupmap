doctype html
html lang="en"
  head
    meta charset="utf-8"
    meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"
    meta name="color-scheme" content="light dark"
    title Fluffy maps
    link rel="stylesheet" href="/vendor/leaflet-1.9.4/leaflet.css"
    link rel="stylesheet" href="/groupmap.css"
    script src="/vendor/leaflet-1.9.4/leaflet.js" defer=true
    script src="/groupmap.js" type="module"

  body
    header.bar
      h1.title Fluffy maps
      label.map-picker
        span.visually-hidden Group picture
        select#map-select disabled=true
          option Loading…
      button#toggle-markers.btn type="button" aria-pressed="true" title="Show or hide markers"
        | Markers
      button#about-open.btn type="button" aria-haspopup="dialog" About

    main#map aria-label="Group picture map"

    div#toast role="status" aria-live="polite" hidden=true

    dialog#about
      form method="dialog"
        h2 About
        p
          strong Tap or click an empty spot on the picture to tag a fluff.
        p I made this little toy project to keep track of fluffy faces.
        p I'm no web developer, I'm no developer.
        p Please reach out to me (links below) for errors and complaints.
        p.links
          a href="https://twitter.com/JokullBarkson" target="_blank" rel="noopener" Author
          a href="https://github.com/Furikuda/groupmap" target="_blank" rel="noopener" Code
        button.btn.btn-primary value="ok" OK!
